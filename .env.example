# CatApp — variables de entorno
# Copia este archivo a .env y rellena los valores. NUNCA commitees .env.
# Lista consolidada en el Apéndice C de PLAN-APP-MANICURISTAS.md.
# Las fases posteriores añadirán sus propias variables (Google, WhatsApp, Sentry, etc.).

# --- F0: Base de datos (Railway la inyecta en producción) ---
DATABASE_URL="postgresql://catapp:catapp@127.0.0.1:5433/catapp"

# --- F1: Autenticación (Better Auth) ---
# Genera el secreto con: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# URL pública de la app (en local: http://localhost:3000)
BETTER_AUTH_URL="http://localhost:3000"
# Google OAuth — login (F1) y Google Calendar (F5).
# Crea las credenciales en Google Cloud Console (ver docs/DEPLOY.md).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- F5: Google Calendar ---
# Clave para cifrar el refresh_token de Google en la DB (AES-256-GCM).
# Genera una con: openssl rand -base64 32
GOOGLE_TOKEN_KEY=""

# --- F8: WhatsApp Cloud API (recordatorios automáticos) ---
# Si están vacías, el módulo queda INERTE (la app funciona igual que en F4).
# Vienen del panel de Meta (WhatsApp > API Setup). Ver docs/DEPLOY.md.
WA_PHONE_NUMBER_ID=""
WA_ACCESS_TOKEN=""
# Token que TÚ defines y pones también en la config del webhook en Meta.
WA_VERIFY_TOKEN=""
# App Secret de Meta (Configuración > Básica) para validar la firma del webhook.
WA_APP_SECRET=""
# Nombres de las plantillas aprobadas en Meta (opcional; valores por defecto
# 'recordatorio' y 'confirmacion').
WA_TEMPLATE_REMINDER=""
WA_TEMPLATE_CONFIRMATION=""
# Secreto que protege el cron de recordatorios (/api/cron/reminders).
# Genera uno con: openssl rand -base64 32
CRON_SECRET=""

# --- F10: Sentry (monitoreo de errores en producción) ---
# DSN de tu proyecto en sentry.io. Si está vacío, Sentry queda inactivo.
# Mismo valor para las dos variables (una es pública, la otra solo servidor).
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
# Token de autenticación para subir source maps en el build de CI.
# Crear en sentry.io > Settings > Auth Tokens (scope: project:releases, org:read).
# NO es necesario en local; solo en CI/Railway.
SENTRY_AUTH_TOKEN=""
# Slug de tu organización y proyecto en Sentry (opcional; usa "catapp"/"catapp-nextjs" por defecto).
SENTRY_ORG=""
SENTRY_PROJECT=""
# Nivel mínimo de logs en producción (debug | info | warn | error). Default: info.
LOG_LEVEL=""

# --- E2E (Playwright) ---
# Usuario de prueba para pnpm test:e2e (debe existir en la DB local).
E2E_TEST_EMAIL=""
E2E_TEST_PASSWORD=""
