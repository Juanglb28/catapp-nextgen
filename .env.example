# CatApp — variables de entorno
# Copia este archivo a .env y rellena los valores. NUNCA commitees .env.
# Lista consolidada en el Apéndice C de PLAN-APP-MANICURISTAS.md.
# Las fases posteriores añadirán sus propias variables (Google, WhatsApp, Sentry, etc.).

# --- F0: Base de datos (Railway la inyecta en producción) ---
DATABASE_URL="postgresql://catapp:catapp@127.0.0.1:5433/catapp"

# --- F1: Autenticación (Better Auth) ---
# Genera el secreto con: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# URL pública de la app (en local: http://localhost:3000)
BETTER_AUTH_URL="http://localhost:3000"
# Opcional (B3.1): clave dedicada para firmar las cookies de app-lock. Si se
# omite, se usa BETTER_AUTH_SECRET. En producción, sin ninguna de las dos, el
# app-lock hace fail-fast (no firma cookies forjables). openssl rand -base64 32.
APP_LOCK_SECRET=""
# Google OAuth — login (F1) y Google Calendar (F5).
# Crea las credenciales en Google Cloud Console (ver docs/DEPLOY.md).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Orígenes de confianza extra para Better Auth (CSV). Opcional; útil si la app se
# sirve en varios dominios. Ej: "https://catapp.co,https://www.catapp.co".
BETTER_AUTH_TRUSTED_ORIGINS=""

# --- Email transaccional (Resend): reset de contraseña + verificación (B3.2) ---
# Sin RESEND_API_KEY los correos NO se envían (solo se loguea la URL) y, como
# consecuencia, la VERIFICACIÓN DE EMAIL y el linking estricto quedan DESACTIVADOS
# (para no dejar a las usuarias sin poder verificar). En producción es
# obligatoria: con ella, nadie inicia sesión ni vincula Google sin verificar su
# correo. API key en https://resend.com/api-keys.
RESEND_API_KEY=""
# Remitente verificado en Resend (ej: "CatApp <no-reply@tudominio.com>").
RESEND_FROM_EMAIL=""

# --- Rate limiting (B3.3) ---
# Proxies de confianza delante de la app para resolver la IP real desde
# X-Forwarded-For (Railway = 1). Con un valor mayor si hay más hops de confianza.
TRUSTED_PROXY_HOPS="1"

# --- reCAPTCHA v3 (protege registro y recuperación de contraseña) ---
# Crea un sitio tipo reCAPTCHA v3 en https://www.google.com/recaptcha/admin/create
# y agrega tus dominios (localhost, staging, catapp.beauty). Si están vacías, la
# protección queda DESACTIVADA (el auth funciona sin captcha). La SITE key es
# pública y se incrusta en el bundle en build (declarada como ARG en el Dockerfile).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# --- Push notifications (Web Push / VAPID) ---
# Genera las 3 con: npx web-push generate-vapid-keys
# Sin ellas NO se registran suscripciones (los cumpleaños/recordatorios push no
# llegan). La NEXT_PUBLIC_* se incrusta en el bundle en build (ver Dockerfile).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# mailto del emisor (ej: "mailto:tu@correo.com").
VAPID_SUBJECT=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# --- F5: Google Calendar ---
# Clave para cifrar el refresh_token de Google en la DB (AES-256-GCM).
# Genera una con: openssl rand -base64 32
GOOGLE_TOKEN_KEY=""

# --- F8: WhatsApp Cloud API (recordatorios automáticos) ---
# Si están vacías, el módulo queda INERTE (la app funciona igual que en F4).
# Vienen del panel de Meta (WhatsApp > API Setup). Ver docs/DEPLOY.md.
WA_PHONE_NUMBER_ID=""
WA_ACCESS_TOKEN=""
# Token que TÚ defines y pones también en la config del webhook en Meta.
WA_VERIFY_TOKEN=""
# App Secret de Meta (Configuración > Básica) para validar la firma del webhook.
WA_APP_SECRET=""
# Nombres de las plantillas aprobadas en Meta (opcional; valores por defecto
# 'recordatorio' y 'confirmacion').
WA_TEMPLATE_REMINDER=""
WA_TEMPLATE_CONFIRMATION=""
# Secreto que protege el cron de recordatorios (/api/cron/reminders).
# Genera uno con: openssl rand -base64 32
CRON_SECRET=""

# --- F10: Sentry (monitoreo de errores en producción) ---
# DSN de tu proyecto en sentry.io. Si está vacío, Sentry queda inactivo.
# Mismo valor para las dos variables (una es pública, la otra solo servidor).
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
# Token de autenticación para subir source maps en el build de CI.
# Crear en sentry.io > Settings > Auth Tokens (scope: project:releases, org:read).
# NO es necesario en local; solo en CI/Railway.
SENTRY_AUTH_TOKEN=""
# Slug de tu organización y proyecto en Sentry (opcional; usa "catapp"/"catapp-nextjs" por defecto).
SENTRY_ORG=""
SENTRY_PROJECT=""
# Nivel mínimo de logs en producción (debug | info | warn | error). Default: info.
LOG_LEVEL=""

# --- Pool de base de datos (opcional) ---
# Máximo de conexiones del pool de pg. Default 20. Ajustar al límite del plan de
# Postgres; si se escala a >1 réplica, repartir el presupuesto de conexiones.
DB_POOL_MAX=""

# --- Tests de integración (Vitest) ---
# Sin esta variable, los *.integration.test.ts se saltan automáticamente.
# Apunta a una DB desechable (docker-compose expone catapp en el puerto 5433).
TEST_DATABASE_URL=""

# --- E2E (Playwright) ---
# Usuario de prueba para pnpm test:e2e (debe existir en la DB local).
E2E_TEST_EMAIL=""
E2E_TEST_PASSWORD=""
